@startuml c4-containers
title GeoLogic — три модуля MVP
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
actor "Предприниматель" as user
rectangle "MAX" as max
package "GeoLogic" {
 rectangle "bot\nLong Polling + Kafka consumer" as bot
 rectangle "api\nnet/http + рейтинг" as api
 rectangle "ingestion\nзагрузка + мониторинг" as worker
 database "API PostgreSQL + PostGIS\nпостоянные данные" as apidb
 database "Ingestion PostgreSQL + PostGIS\ncompetitor_cache" as ingestiondb
 queue "Kafka\nnotifications" as kafka
 rectangle "OSRM\nOSM / foot.lua" as osrm
}
rectangle "Geocoder" as geo
rectangle "Источники инфраструктуры / Events" as sources
rectangle "2ГИС" as gis
user <--> max
bot --> max : polling / ответы / оповещения
bot --> api : пользовательский HTTP API
worker --> api : загрузка / точки / события / отметки
api --> apidb : постоянные данные
api --> geo
api --> osrm : рейтинг при создании точки
worker --> ingestiondb : только свой кэш
worker --> sources
worker --> gis : открытия за вчера
worker --> osrm : маршрут для уведомления
worker --> kafka : produce
kafka --> bot : group bot-notifications
@enduml
