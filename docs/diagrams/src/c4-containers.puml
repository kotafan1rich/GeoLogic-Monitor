@startuml c4-containers
title GeoLogic — три модуля MVP
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
actor "Предприниматель" as user
rectangle "MAX" as max
rectangle "MAX Mini App\nточки / рейтинг / история" as miniapp
package "GeoLogic" {
 rectangle "bot\n/start + Kafka consumer" as bot
 rectangle "api\nnet/http + рейтинг + планировщик" as api
 rectangle "ingestion\nзагрузка + мониторинг" as worker
 database "API PostgreSQL + PostGIS\nпостоянные данные" as apidb
 database "Ingestion PostgreSQL + PostGIS\ncompetitor_cache" as ingestiondb
 queue "Kafka\nnotifications" as kafka
 rectangle "OSRM\nOSM / foot.lua" as osrm
}
rectangle "DaData Suggest" as geo
rectangle "Источники инфраструктуры / Events" as sources
rectangle "2ГИС" as gis
user <--> max
bot --> max : /start / запуск Mini App / оповещения
user <--> miniapp
max --> miniapp : открыть
miniapp --> api : HTTP / проверенные initData
bot --> api : регистрация чата / сервисный токен
worker --> api : загрузка / точки / события / пешие расстояния / отметки
api --> apidb : постоянные данные
api --> geo
api --> osrm : рейтинг / пешие расстояния для ingestion
worker --> ingestiondb : только свой кэш
worker --> sources
worker --> gis : открытия за вчера
worker --> kafka : produce
kafka --> bot : group bot-notifications
@enduml
