@startuml c4-components
title GeoLogic — компоненты API
left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
rectangle "cmd/server" as main
rectangle "app/di.go" as di
rectangle "net/http / router\nBotToken / IngestionToken" as server
rectangle "handler\nusers / locations / geocoding\ninfra / business types / events" as handler
rectangle "service\nбизнес-правила + rating calculator" as service
rectangle "repository\nPostgreSQL / Geocoder / OSRM\nлокальные model" as repo
rectangle "domain\nUser / TrackedLocation / GeoPoint\nInfra / Event / LocationFeatures\nCalculatedRating" as domain
database "API PostgreSQL + PostGIS" as db
rectangle Geocoder as geo
rectangle "OSRM\nfoot profile" as osrm
main --> di
di --> server
server --> handler
handler --> service
service --> repo : интерфейсы
service ..> domain
repo ..> domain
repo --> db : pgx / SQL
repo --> geo
repo --> osrm : пешеходные расстояния
@enduml
