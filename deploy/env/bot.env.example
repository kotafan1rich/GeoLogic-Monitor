API_PORT=8080
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=60s

API_BASE_URL=http://api:8080
API_TIMEOUT=5s

WEBHOOK_URL=https://geologic-monitor.duckdns.org/bot/webhook
WEBHOOK_SECRET=replace-with-random-webhook-secret
MAX_BOT_TOKEN=replace-with-max-bot-token
BOT_SERVICE_TOKEN=replace-with-shared-bot-service-token

KAFKA_BROKERS=kafka:19092
KAFKA_TOPIC=notifications
KAFKA_GROUP_ID=bot-notifications

LOG_LEVEL=info
LOG_FORMAT=json
LOG_ADD_SOURCE=true
